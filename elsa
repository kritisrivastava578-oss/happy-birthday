<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday | Special Surprise</title>
    <!-- Google Fonts for Aesthetic Cursive & Clean Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Great+Vibes&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            /* Playful & Vibrant Gradient Vibe */
            background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 50%, #7928ca 100%);
            color: #ffffff;
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
        }

        .page {
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: absolute;
            top: 0;
            left: 0;
            transition: opacity 0.8s ease-in-out, transform 0.8s ease-in-out;
            padding: 20px;
            text-align: center;
        }

        .hidden {
            opacity: 0;
            transform: translateY(50px);
            pointer-events: none;
        }

        /* Typography */
        h1 {
            font-family: 'Cinzel', serif;
            font-size: 2.5rem;
            color: #fff;
            margin-bottom: 15px;
            letter-spacing: 2px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }

        .cursive-text {
            font-family: 'Great Vibes', cursive;
            font-size: 2.2rem;
            color: #fff5cc;
            margin-top: 10px;
            margin-bottom: 20px;
            text-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        p {
            font-size: 1.1rem;
            color: #f9f9f9;
            max-width: 500px;
            line-height: 1.6;
            margin-bottom: 30px;
            font-weight: 300;
        }

        /* Photo Placeholder Box (Page 1) */
        .photo-frame {
            width: 170px;
            height: 210px;
            border: 3px dashed #ffffff;
            border-radius: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(5px);
            margin-bottom: 10px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow: hidden;
        }

        .photo-frame span {
            font-size: 0.85rem;
            color: #fff;
            font-style: italic;
        }

        /* Note: Agar yahan photo lagani ho toh <span> ki jagah yeh image tag use karein: */
        /* <img src="YOUR_PHOTO_LINK.jpg" alt="Birthday Girl" style="width:100%; height:100%; object-fit:cover;"> */

        /* Buttons & Interactive Elements */
        .btn {
            background: #ffffff;
            color: #7928ca;
            border: none;
            padding: 12px 35px;
            font-size: 1rem;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            letter-spacing: 1px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
        }

        .btn:hover {
            background: #fff5cc;
            transform: scale(1.05);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        }

        /* Page 2 Message Card Styling */
        .message-card {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(12px);
            padding: 30px;
            border-radius: 20px;
            max-width: 450px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        }

        /* Floating subtle glow animation */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
            100% { transform: translateY(0px); }
        }

        .floating {
            animation: float 4s ease-in-out infinite;
        }
    </style>
</head>
<body>

    <!-- PAGE 1: Welcome & Photo Placeholder -->
    <div id="page1" class="page floating">
        <div class="photo-frame">
            <span>[ Insert Photo Here ]</span>
        </div>
        <p class="cursive-text">the prettiest girl i have ever seen ✨</p>
        <p>A very special day for an exceptionally amazing soul. Ready to see what's waiting for you?</p>
        <button class="btn" onclick="nextPage()">Open Surprise ➔</button>
    </div>

    <!-- PAGE 2: Aesthetic Heartfelt Message -->
    <div id="page2" class="page hidden">
        <div class="message-card">
            <h1>HAPPY BIRTHDAY</h1>
            <p>
                May this year bring infinite joy, success, and all the vibrant vibes you deserve. Keep shining like the absolute star you are! Wishing you the happiest birthday ever. 💖🎉
            </p>
            <button class="btn" onclick="prevPage()">⬅ Back</button>
        </div>
    </div>

    <script>
        function nextPage() {
            document.getElementById('page1').classList.add('hidden');
            document.getElementById('page2').classList.remove('hidden');
        }

        function prevPage() {
            document.getElementById('page2').classList.add('hidden');
            document.getElementById('page1').classList.remove('hidden');
        }
    </script>
</body>
</html>
